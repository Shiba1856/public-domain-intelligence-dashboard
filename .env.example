# Copy this file to ".env" and edit the copy. Never commit ".env".
FLASK_SECRET_KEY=change-me-to-a-long-random-string
USER_AGENT="PublicDomainDashboard/1.0 (educational project; replace with your contact info)"
REQUEST_TIMEOUT=8
DNS_TIMEOUT=4
CT_TIMEOUT=20
MAX_RESPONSE_BYTES=262144
CT_MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=3
CT_MAX_ENTRIES=15
COOLDOWN_SECONDS=10
DATABASE_PATH=data/investigations.db
REPORTS_DIR=reports